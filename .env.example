# Copy to .env and fill in. .env is gitignored and dockerignored.
# Keys are read in config.py and nowhere else — no other module calls os.getenv for one.

# --- primary provider: extraction (Haiku 4.5) + composition (Sonnet 5) ---
# Required. See registry.ROLES for the split and README §3 for why it is a split.
ANTHROPIC_API_KEY=

# --- embeddings (required for the FAQ/RAG path), and the dev-only fallback vendor ---
# Anthropic and Groq have no embeddings endpoint, so this is the only implemented embed path.
# Free tier: ~15 req/min, ~1000 embed req/day.
GEMINI_API_KEY=

# --- eval sweeps only: never a live primary or backup ---
# OpenAI-compatible endpoint, higher throughput — a full 12-scenario sweep is ~200 calls.
GROQ_API_KEY=

# --- present but unused ---
# providers/openai.py implements the Responses API (GPT-5.6 luna/terra) and is wired up, but the
# account behind this key has no billing credits, so no call has completed end to end. It is
# deliberately kept out of registry.ROLES until it has. See README §3.
OPENAI_API_KEY=

# dev | demo | prod. Free-tier models (Google, Groq) are refused unless this is "dev" — those
# tiers permit the vendor to train on submitted prompts, which candidate data is not eligible for.
# Enforced at startup by config.assert_model_allowed().
APP_ENV=dev
