# Copy to .env and fill in. .env is gitignored and dockerignored.

# --- dev loop: free tiers, synthetic candidates only ---
GEMINI_API_KEY=          # interactive dev; Flash-class, ~15 req/min, ~1000/day
GROQ_API_KEY=            # eval sweeps; OpenAI-compatible endpoint, higher throughput

# --- primary provider (extraction + composition) and embeddings ---
OPENAI_API_KEY=

# --- fallback provider ---
ANTHROPIC_API_KEY=

# dev | demo | prod. Free-tier models are refused unless this is "dev".
APP_ENV=dev
