# Internal working docs — never enter the image
_internal/
scratch/
*.local.md

# VCS & CI
.git/
.github/
.gitignore

# secrets
.env
.env.*
!.env.example

# python build/test artifacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# runtime data
data/
*.db
*.sqlite3

# docs & media not needed at runtime
docs/
samples/
*.md
!README.md
# ...but the FAQ knowledge base is source, not documentation, even though it's markdown.
# `rag/index.py` parses these at runtime to build the Chroma collection; without this negation
# the blanket `*.md` above silently ships an image whose RAG has nothing to index.
!src/screening_agent/rag/*.md

# editors / os
.DS_Store
.idea/
.vscode/

node_modules/
